{
  "build": {
    "dockerfile": "../Dockerfile.dev",
    "context": ".."
  },
  "install": "./scripts/native-dev-install.sh",
  "start": "./scripts/native-dev-deps.sh",
  "terminals": [
    {
      "name": "api",
      "command": ". .venv/bin/activate && ./start.sh --init-test-data",
      "description": "Backend API on :8000 with PRELOOP_SERVICE_ROLE=all. Omit --init-test-data after the first boot."
    },
    {
      "name": "frontend",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0",
      "description": "Vite console on :5173. Proxies /api, /mcp, /openai, /anthropic to :8000."
    }
  ],
  "ports": [
    { "name": "api", "port": 8000 },
    { "name": "frontend", "port": 5173 }
  ]
}
