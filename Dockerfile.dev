# Native (no Compose) machine image: PostgreSQL 16 + pgvector, NATS, Python 3.12, Node 22.
# Does not COPY the app. Cursor Cloud checks out the commit; a local run should
# bind-mount the repo. See docs/native-dev.md.
FROM ubuntu:24.04@sha256:33ceb71981b602c1a7443a53469e4dba065f7503eab3078a2d7a57a2ab987517

SHELL ["/bin/bash", "-euo", "pipefail", "-c"]

ENV DEBIAN_FRONTEND=noninteractive \
    NODE_VERSION=22.18.0 \
    NATS_SERVER_VERSION=2.11.8

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    xz-utils \
    build-essential \
    libpq-dev \
    python3 \
    python3-dev \
    python3-venv \
    python3-pip \
    postgresql-16 \
    postgresql-contrib \
    postgresql-16-pgvector \
    sudo \
    procps \
    && rm -rf /var/lib/apt/lists/*

RUN arch="$(dpkg --print-architecture)" \
    && case "$arch" in \
         amd64) node_arch=x64; nats_arch=amd64 ;; \
         arm64) node_arch=arm64; nats_arch=arm64 ;; \
         *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
       esac \
    && curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${node_arch}.tar.xz" \
         | tar -xJ -C /usr/local --strip-components=1 \
    && curl -fsSL "https://github.com/nats-io/nats-server/releases/download/v${NATS_SERVER_VERSION}/nats-server-v${NATS_SERVER_VERSION}-linux-${nats_arch}.tar.gz" \
         | tar -xz -C /tmp \
    && install -m 0755 "/tmp/nats-server-v${NATS_SERVER_VERSION}-linux-${nats_arch}/nats-server" /usr/local/bin/nats-server \
    && rm -rf "/tmp/nats-server-v${NATS_SERVER_VERSION}-linux-${nats_arch}"

RUN echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/ubuntu \
    && chmod 0440 /etc/sudoers.d/ubuntu

RUN <<'EOF'
pg_ctlcluster 16 main start
su - postgres -c "psql -c \"ALTER USER postgres WITH PASSWORD 'postgres';\""
su - postgres -c "createdb preloop" || true
su - postgres -c "psql -d preloop -c 'CREATE EXTENSION IF NOT EXISTS vector;'"
pg_ctlcluster 16 main stop
EOF

USER ubuntu
WORKDIR /home/ubuntu

CMD ["bash"]
