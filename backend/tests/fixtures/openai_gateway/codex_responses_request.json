{
  "model": "openai/gpt-5",
  "input": "Review this pull request.",
  "tools": [
    {
      "type": "web_search"
    },
    {
      "type": "function",
      "name": "get_pull_request",
      "description": "Fetch one pull request",
      "parameters": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "type": "custom",
      "name": "local_shell",
      "description": "Run a shell command"
    },
    {
      "type": "custom",
      "name": "apply_patch",
      "description": "Apply a patch",
      "format": {
        "type": "grammar",
        "syntax": "lark",
        "definition": "start: \"*** Begin Patch\""
      }
    },
    {
      "type": "tool_search"
    },
    {
      "type": "namespace",
      "name": "mcp__preloop",
      "tools": [
        {
          "type": "function",
          "name": "preloop_get_goal",
          "description": "Fetch a goal",
          "parameters": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "type": "function",
          "name": "preloop_update_goal",
          "description": "Update a goal",
          "parameters": {
            "type": "object",
            "properties": {}
          }
        }
      ]
    }
  ],
  "tool_choice": "auto"
}
