# Placeholders for the local harness only. Copy to .env; verify.sh does this
# automatically when .env is missing. None of these is a real credential.
CLAUDE_CODE_VERSION=2.1.288
OIDC_CLIENT_SECRET=harness-dex-client-secret
GATEWAY_JWT_SECRET=harness-only-jwt-secret-change-me-0123456789abcdef
# Preloop API key the gateway uses upstream. seed.py creates a key with this
# exact value and the scope model_gateway:trusted_upstream.
PRELOOP_UPSTREAM_KEY=pl-harness-trusted-upstream-key-0000000000
# Sent by the gateway as x-preloop-upstream-secret; seed.py stores its sha256.
PRELOOP_UPSTREAM_SECRET=harness-upstream-secret-0000000000
# Preloop API key the gateway's telemetry.forward_to destination sends.
# seed.py creates a key with this exact value and the scope telemetry:ingest.
PRELOOP_TELEMETRY_KEY=pl-harness-telemetry-ingest-key-0000000000
PRELOOP_SECRET_KEY=harness_only_secret_key_do_not_use_elsewhere
PRELOOP_DISABLE_TELEMETRY=true
