# Preloop origin: Cloud or your own instance (no trailing slash).
PRELOOP_URL=http://localhost:8000
# Durable credential of the custom managed agent you registered for this task.
# One token covers both the model gateway and approval requests.
PRELOOP_AGENT_TOKEN=
# Model name as configured in Preloop (Models page). The gateway routes it to
# the provider key stored in Preloop, so no provider key lives in trigger.dev.
PRELOOP_MODEL=gpt-4o-mini

# Only for `npx trigger.dev dev` / deploy.
TRIGGER_PROJECT_REF=
