# Strict-Transport-Security (#2279). TLS always terminates in front of this
# nginx (it listens on 80 only), so "arrived over HTTPS" means the terminator
# set X-Forwarded-Proto: https, or the scheme itself is https. The HSTS_*
# values come from the environment through envsubst (defaults in the
# Dockerfile). An empty $preloop_hsts means nginx sends no header.
map "${HSTS_ENABLED}" $preloop_hsts_enabled {
    "~*^(true|1|yes|on)$" 1;
    default 0;
}

map "${HSTS_INCLUDE_SUBDOMAINS}" $preloop_hsts_subdomains {
    "~*^(true|1|yes|on)$" "; includeSubDomains";
    default "";
}

map "${HSTS_PRELOAD}" $preloop_hsts_preload {
    "~*^(true|1|yes|on)$" "; preload";
    default "";
}

# Referrer-Policy default for the shared header set. When a proxied upstream
# already sent one (the API uses no-referrer where the URL carries an OAuth
# code or a signed token), yield "" so nginx adds no second, weaker policy.
map $upstream_http_referrer_policy $preloop_referrer_policy {
    "" "strict-origin-when-cross-origin";
    default "";
}

map "$preloop_hsts_enabled:$http_x_forwarded_proto:$scheme" $preloop_hsts {
    "~*^1:https" "max-age=${HSTS_MAX_AGE}$preloop_hsts_subdomains$preloop_hsts_preload";
    "~*^1:[^:]*:https$" "max-age=${HSTS_MAX_AGE}$preloop_hsts_subdomains$preloop_hsts_preload";
    default "";
}

# Content-Security-Policy (#2280). 15-preloop-csp.envsh validates CSP_MODE
# and the extra sources and builds PRELOOP_CSP_SCRIPT_SRC and
# PRELOOP_CSP_CONNECT_SRC; the container does not start on a bad value.
#
#   report-only  legacy Content-Security-Policy plus the new policy as
#                Content-Security-Policy-Report-Only (default)
#   enforce      the new policy as Content-Security-Policy, nothing else
#   legacy       the legacy Content-Security-Policy only
#
# The new policy covers what this nginx serves from the console build.
# Responses proxied from the API ($upstream_addr is set) and the separate
# admin SPA under /admin keep the legacy header in every mode: the console's
# violation sweep loads neither. Keep the policy identical to
# "preloop.nginxCspMap" in helm/preloop/templates/_helpers.tpl.
map "" $preloop_csp_policy {
    default "default-src 'self'; script-src ${PRELOOP_CSP_SCRIPT_SRC}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src ${PRELOOP_CSP_CONNECT_SRC}; media-src 'self' blob:; worker-src 'self' blob:; frame-src https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'";
}

# 1 for what nginx serves from the console build, 0 for proxied responses
# ($upstream_addr set) and the separate admin SPA under /admin, which the
# console's violation sweep does not load.
map "$upstream_addr:$uri" $preloop_csp_console {
    "~^:/admin(/|$)" 0;
    "~^:" 1;
    default 0;
}

map "${CSP_MODE}:$preloop_csp_console" $preloop_csp {
    "enforce:1" $preloop_csp_policy;
    default "default-src 'self' http: https: data: blob: 'unsafe-inline'";
}

map "${CSP_MODE}:$preloop_csp_console" $preloop_csp_report_only {
    "report-only:1" $preloop_csp_policy;
    default "";
}

server {
    listen 80;
    server_name localhost;

    # Every backend below is proxied through a variable (proxy_pass $var), which
    # makes nginx resolve the host at request time instead of at startup — and
    # that needs an explicit resolver. Without it every /api and gateway request
    # fails with "no resolver defined". 127.0.0.11 is Docker's embedded DNS;
    # override with NGINX_RESOLVER when running outside Docker's default bridge.
    resolver ${NGINX_RESOLVER} ipv6=off valid=30s;

    # Security headers. Every block below that declares its own add_header
    # must include this snippet again: nginx does not inherit add_header into
    # such blocks (#2278).
    include /etc/nginx/snippets/security-headers.conf;

    # Only this nginx sets HSTS; drop any copy from an upstream so proxied
    # responses never carry two. No location may declare proxy_hide_header,
    # or this server-level one stops applying there.
    proxy_hide_header Strict-Transport-Security;

    # Root directory for static files
    root /usr/share/nginx/html;
    index index.html;

    # Blocking native approvals support workflow waits up to 24h + 60s headroom.
    # Scope this to the exact endpoint; other API requests keep their normal wait.
    location = /api/v1/agents/permission-check {
        set $api_backend "${API_URL}";

        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 86460s;
        proxy_read_timeout 86460s;
    }

    # Remote installers run for up to 700s, followed by bounded VM cleanup.
    # Keep the deadline specific to the deployment endpoint.
    location = /api/v1/agent-deployments {
        set $api_backend "${API_URL}";
        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 930s;
        proxy_read_timeout 930s;
    }

    # API proxy configuration
    location /api/ {
        # Choose API backend based on MOCK_API environment variable
        set $api_backend "${API_URL}";

        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 10s;
        # LLM-powered analysis (cost optimization suggestions) and replay
        # verification legitimately run ~90s on slower models; 60s here 504s the
        # browser while the backend finishes. Durable fix is async jobs + polling.
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;

        # CORS headers for API requests
        include /etc/nginx/snippets/security-headers.conf;
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization' always;
        add_header 'Access-Control-Expose-Headers' 'Content-Length,Content-Range' always;

        # Handle preflight requests
        if ($request_method = 'OPTIONS') {
            include /etc/nginx/snippets/security-headers.conf;
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'DNT,User-Agent,X-Requested-With,If-Modified-Since,Cache-Control,Content-Type,Range,Authorization';
            add_header 'Access-Control-Max-Age' 1728000;
            add_header 'Content-Type' 'text/plain; charset=utf-8';
            add_header 'Content-Length' 0;
            return 204;
        }
    }

    # MCP server proxy configuration
    # Use prefix match with ^~ to stop searching and prevent SPA catch-all
    # /mcp → /mcp/v1 rewrite is handled by the backend's ASGI middleware
    location ^~ /mcp {
        set $api_backend "${API_URL}";

        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Model gateway endpoints (OpenAI-, Anthropic- and Gemini-compatible).
    #
    # These three carry streaming LLM traffic and are the route class that most
    # needs a long timeout, yet they were the only proxied routes without one —
    # so they silently inherited nginx's 60s default. On a streaming completion
    # the clock to the first byte is the model's thinking time: a short prompt
    # answers in seconds, while a large one (a full diff, a repository's worth
    # of context) can reason for minutes before emitting a single token. At 60s
    # that connection is killed and the caller sees a 504 from the proxy — a
    # failure the gateway never observes and cannot report, and one that looks
    # intermittent because it depends entirely on prompt size.
    #
    # proxy_buffering must stay off: with buffering on nginx accumulates the
    # token stream rather than relaying it, which both defeats the point of SSE
    # for the client and pushes the observed first byte later, making any
    # ceiling easier to hit.
    location ^~ /openai/ {
        set $gateway_backend "${GATEWAY_URL}";

        proxy_pass $gateway_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        proxy_buffering off;
        proxy_cache off;
        client_max_body_size 32m;
    }

    location ^~ /anthropic/ {
        set $gateway_backend "${GATEWAY_URL}";

        proxy_pass $gateway_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        proxy_buffering off;
        proxy_cache off;
        client_max_body_size 32m;
    }

    location ^~ /gemini/ {
        set $gateway_backend "${GATEWAY_URL}";

        proxy_pass $gateway_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 900s;
        proxy_read_timeout 900s;
        proxy_buffering off;
        proxy_cache off;
        client_max_body_size 32m;
    }

    # OAuth server endpoints (authorize, token, register, revoke)
    # Must be proxied to backend before the SPA catch-all
    location ^~ /oauth/ {
        set $api_backend "${API_URL}";

        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OAuth / MCP well-known discovery endpoints
    location ^~ /.well-known/ {
        set $api_backend "${API_URL}";

        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Invitation accept page proxy configuration (public invitation accept)
    # Use prefix match with ^~ to stop searching and prevent SPA catch-all
    location ^~ /invitations/accept {
        set $api_backend "${API_URL}";

        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public approval endpoints (token-based, no /api/ prefix)
    location ^~ /approval/ {
        set $api_backend "${API_URL}";

        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Public installer endpoints
    location ^~ /install/ {
        set $api_backend "${API_URL}";

        proxy_pass $api_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The EE image ships a separate admin SPA. Deep links must boot that app,
    # which checks superuser access before initializing its router.
    location = /admin {
        return 308 /admin/$is_args$args;
    }

    location /admin/ {
        try_files $uri $uri/ /admin/index.html;
    }

    # Missing assets must return 404, including extensions outside the regex below.
    location ^~ /admin/assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location = /admin/index.html {
        include /etc/nginx/snippets/security-headers.conf;
        # OSS images have no admin build. Stop here instead of redirecting again.
        try_files $uri =404;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Static files with caching
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg)$ {
        include /etc/nginx/snippets/security-headers.conf;
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Prerendered top-level pages. Serve the .html the build emitted; otherwise
    # the SPA. This is not an allowlist: EE adds a page by dropping markdown
    # under frontend/content/<brand>/, which Vite prerenders to /<slug>.html.
    location ~ ^/([a-z0-9][a-z0-9-]*)$ {
        try_files /$1.html /index.html;
    }

    location = /robots.txt {
        try_files /robots.txt =404;
    }

    location = /sitemap.xml {
        try_files /sitemap.xml =404;
    }

    location = /llms.txt {
        try_files /llms.txt =404;
    }

    # Competitor comparison pages (/vs/<slug>): serve the build-time prerendered
    # HTML so crawlers and direct loads get the real page (correct <title>,
    # canonical, and data-ssr-route) instead of the home index.html. Falls back
    # to the SPA for unregistered slugs. Without this, /vs/<slug> hit the SPA
    # catch-all below and rendered the landing page nested inside static-view.
    location ~ ^/vs/([a-z0-9][a-z0-9-]*)/?$ {
        try_files /vs/$1.html /index.html;
    }

    # Long-form resource pages (/resources/<slug>): same prerender-first serving.
    location ~ ^/resources/([a-z0-9][a-z0-9-]*)/?$ {
        try_files /resources/$1.html /index.html;
    }

    # Blog index (/blog): prerender-first, same as /vs/ and /resources/. Only
    # SaaS builds emit blog/index.html; self-hosted builds fall through to the
    # SPA, which has no /blog route registered and redirects home.
    location = /blog {
        try_files /blog/index.html /index.html;
    }

    # RSS feed. Exact-match so it wins over the /blog/<slug> regex below.
    location = /blog/feed.xml {
        # `types { }` empties the MIME map for this location. Without it
        # mime.types already maps .xml -> text/xml, that match wins, and
        # default_type (which only applies when nothing matched) is dead code.
        types { }
        default_type application/rss+xml;
        try_files /blog/feed.xml =404;
    }

    # Blog posts (/blog/<slug>).
    location ~ ^/blog/([a-z0-9][a-z0-9-]*)/?$ {
        try_files /blog/$1.html /index.html;
    }

    # SPA routing - serve index.html for all non-API routes
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Disable caching for index.html
    location = /index.html {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Health check endpoint. `default_type` (not `add_header Content-Type`,
    # which is dead code after `return`) sets the response MIME type.
    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }
}
