{
  "name": "preloop",
  "version": "0.17.1",
  "description": "Preloop console frontend",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "main": "src/main.ts",
  "overrides": {
    "static-eval": "^2.1.0",
    "minimist": "^1.2.8",
    "koa": "^2.16.4",
    "fast-xml-parser": "^5.5.7",
    "fast-xml-builder": "^1.1.7",
    "picomatch": "^4.0.4",
    "lodash-es": "^4.18.1",
    "basic-ftp": "5.3.1",
    "uuid": ">=14.0.0",
    "ip-address": "^10.1.1",
    "esbuild": "^0.28.1",
    "errorstacks": "2.4.1",
    "postcss": "^8.5.18",
    "yaml": "2.9.0",
    "image-size": "npm:image-size-next@2.1.1",
    "fflate": "0.7.5",
    "cookies": "0.9.2",
    "braces": "$braces"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "npm run test:config && node scripts/check-unreferenced-todos.mjs && node scripts/check-custom-element-imports.mjs && node scripts/check-frontend-console.mjs && node scripts/check-frontend-accessibility.mjs && web-test-runner \"src/**/*.test.{ts,js}\" && npm run test:fleet-map",
    "test:config": "node --test scripts/test-concurrency.test.mjs scripts/shoelace-vendor.test.mjs scripts/braces-depth.test.mjs scripts/frontend-accessibility.test.mjs scripts/blog-frontmatter.test.mjs",
    "test:coverage": "web-test-runner \"src/**/*.test.{ts,js}\" --coverage",
    "test:visual": "playwright test tests/visual/",
    "test:visual:update": "playwright test tests/visual/ --update-snapshots",
    "test:visual:ui": "playwright test tests/visual/ --ui",
    "test:e2e:ci": "playwright test --project=e2e-ci",
    "test:e2e:staging": "PRELOOP_E2E_TARGET=staging playwright test --project=e2e-staging",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "docker:dev": "./docker-run.sh dev",
    "docker:prod": "./docker-run.sh prod",
    "docker:mock": "./docker-run.sh mock",
    "docker:build": "./docker-run.sh build",
    "docker:test": "./docker-run.sh test",
    "test:fleet-map": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@novnc/novnc": "file:vendor/novnc",
    "@sentry/browser": "^11.8.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "@tanstack/table-core": "^9.3.1",
    "ansi_up": "^6.0.2",
    "dompurify": "^3.4.17",
    "lit": "^3.3.3",
    "marked": "^18.1.1"
  },
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^22.0.0",
    "@vitest/browser-playwright": "^4.1.12",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-commands": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.0",
    "braces": "file:vendor/braces",
    "husky": "^9.0.11",
    "js-yaml": "^5.5.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sinon": "^22.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^4.1.12",
    "ws": "^8.22.0"
  },
  "lint-staged": {
    "src/**/*.ts": "prettier --write"
  }
}
