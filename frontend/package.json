{
  "name": "preloop",
  "version": "0.15.0",
  "description": "Preloop console frontend",
  "main": "src/main.ts",
  "overrides": {
    "static-eval": "^2.1.0",
    "minimist": "^1.2.8",
    "koa": "^2.16.4",
    "fast-xml-parser": "^5.5.7",
    "fast-xml-builder": "^1.1.7",
    "picomatch": "^4.0.4",
    "lodash-es": "^4.18.1",
    "basic-ftp": "5.3.1",
    "uuid": ">=14.0.0",
    "ip-address": "^10.1.1",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.18",
    "yaml": "2.8.3",
    "image-size": "npm:image-size-next@2.1.1",
    "fflate": "0.7.5"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "web-test-runner \"src/**/*.test.{ts,js}\"",
    "test:coverage": "web-test-runner \"src/**/*.test.{ts,js}\" --coverage",
    "test:visual": "playwright test tests/visual/",
    "test:visual:update": "playwright test tests/visual/ --update-snapshots",
    "test:visual:ui": "playwright test tests/visual/ --ui",
    "test:e2e:ci": "playwright test --project=e2e-ci",
    "test:e2e:staging": "PRELOOP_E2E_TARGET=staging playwright test --project=e2e-staging",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "docker:dev": "./docker-run.sh dev",
    "docker:prod": "./docker-run.sh prod",
    "docker:mock": "./docker-run.sh mock",
    "docker:build": "./docker-run.sh build",
    "docker:test": "./docker-run.sh test"
  },
  "dependencies": {
    "@sentry/browser": "^10.73.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "@tanstack/table-core": "^9.2.4",
    "ansi_up": "^6.0.2",
    "dompurify": "^3.4.14",
    "lit": "^3.3.3",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@playwright/test": "^1.63.0",
    "@types/marked": "^5.0.2",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^17.0.4",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.20.0",
    "@web/test-runner-commands": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.1",
    "chai": "^5.0.0",
    "husky": "^9.0.11",
    "js-yaml": "^4.3.2",
    "lint-staged": "^15.2.7",
    "prettier": "^3.9.6",
    "sinon": "^21.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.5",
    "vite-plugin-css-injected-by-js": "^4.0.1"
  },
  "lint-staged": {
    "src/**/*.ts": "prettier --write"
  }
}
