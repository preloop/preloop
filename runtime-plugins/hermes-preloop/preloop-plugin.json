{
  "name": "preloop-hermes-plugin",
  "displayName": "Preloop",
  "description": "Hold your Hermes agent's dangerous tool calls for approval on phone, watch, Slack, Mattermost, email or the web console, keep an audit trail of every decision, and talk to a running session from anywhere.",
  "version": "0.3.1",
  "runtime": "hermes",
  "license": "Apache-2.0",
  "homepage": "https://preloop.ai",
  "repository": "https://github.com/preloop/preloop/tree/main/runtime-plugins/hermes-preloop",
  "keywords": [
    "preloop",
    "hermes",
    "approvals",
    "tool-approval",
    "human-in-the-loop",
    "governance",
    "policy",
    "audit",
    "budget",
    "cost-control",
    "control-plane",
    "remote-control",
    "agent-control",
    "observability",
    "voice"
  ],
  "entrypoint": "preloop_hermes_plugin.plugin",
  "permissions": [
    "read_config:preloop.control",
    "network:wss",
    "network:https",
    "agent:send_message",
    "agent:session_status",
    "agent:tool_approval"
  ],
  "capabilities": {
    "tool_approval": true
  },
  "hooks": [
    "pre_tool_call"
  ],
  "configSchema": {
    "path": "preloop.control",
    "required": [
      "control_ws_url",
      "bearer_token",
      "runtime_principal_id"
    ]
  },
  "verification": {
    "command": "preloop-hermes-plugin verify --config ~/.hermes/config.yaml"
  }
}
