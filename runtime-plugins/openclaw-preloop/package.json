{
  "name": "@preloop-ai/openclaw-plugin",
  "version": "0.3.1",
  "description": "Approve or deny your OpenClaw agent's dangerous tool calls from your phone, watch, Slack or the web, and talk to a running session from anywhere.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify": "node dist/index.js verify",
    "test": "npm run build && node --test"
  },
  "keywords": [
    "preloop",
    "openclaw",
    "approvals",
    "tool-approval",
    "human-in-the-loop",
    "governance",
    "policy",
    "audit",
    "budget",
    "cost-control",
    "control-plane",
    "remote-control",
    "agent-control",
    "observability",
    "voice",
    "autonomous-agents"
  ],
  "bin": {
    "preloop-openclaw-plugin": "dist/index.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.6.11",
      "pluginSdkVersion": "2026.6.11"
    },
    "install": {
      "clawhubSpec": "@preloop-ai/openclaw-plugin",
      "npmSpec": "@preloop-ai/openclaw-plugin",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.3.24-beta.2"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    },
    "hooks": [
      "before_tool_call"
    ],
    "capabilities": {
      "tool_approval": true
    },
    "permissions": [
      "read_config:plugins.entries.preloop-plugin.config",
      "network:wss",
      "network:https",
      "agent:send_message",
      "agent:session_status",
      "agent:tool_approval"
    ],
    "configPath": "plugins.entries.preloop-plugin.config",
    "verification": {
      "command": "preloop-openclaw-plugin verify --config ~/.openclaw/openclaw.json"
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preloop/preloop.git",
    "directory": "runtime-plugins/openclaw-preloop"
  },
  "homepage": "https://preloop.ai",
  "bugs": {
    "url": "https://github.com/preloop/preloop/issues"
  },
  "displayName": "Preloop"
}
