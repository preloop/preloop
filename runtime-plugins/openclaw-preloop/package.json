{
  "name": "@preloop-ai/openclaw-plugin",
  "version": "0.2.0",
  "description": "Preloop exposure and Agent Control plugin for OpenClaw",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "verify": "node dist/index.js verify",
    "test": "npm run build && node --test"
  },
  "keywords": [
    "preloop",
    "openclaw",
    "agent-control",
    "voice",
    "tool-approval",
    "autonomous-agents"
  ],
  "bin": {
    "preloop-openclaw-plugin": "dist/index.js"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.3.24-beta.2",
      "minGatewayVersion": "2026.3.24-beta.2"
    },
    "build": {
      "openclawVersion": "2026.6.11",
      "pluginSdkVersion": "2026.6.11"
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/preloop/preloop.git",
    "directory": "runtime-plugins/openclaw-preloop"
  },
  "homepage": "https://preloop.ai",
  "bugs": {
    "url": "https://github.com/preloop/preloop/issues"
  }
}
