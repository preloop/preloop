<?xml version="1.0" encoding="UTF-8"?>
<!-- Synthetic fixture: site sued, workflow goods-receipt. Sample only, no engine config. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" id="defs_sued_goods_receipt" targetNamespace="https://example.com/warehouse-sim">
  <bpmn:process id="goods-receipt" name="Goods receipt (sued)" isExecutable="false">
    <bpmn:startEvent id="start" />
    <bpmn:task id="step_1" name="Unload truck" />
    <bpmn:task id="step_2" name="Inspect pallets" />
    <bpmn:endEvent id="end" />
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="step_1" />
    <bpmn:sequenceFlow id="f2" sourceRef="step_1" targetRef="step_2" />
    <bpmn:sequenceFlow id="f3" sourceRef="step_2" targetRef="end" />
  </bpmn:process>
</bpmn:definitions>
